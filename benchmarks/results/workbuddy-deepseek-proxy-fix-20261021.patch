+func TestChatModelParamInvalidReturns400WithoutAccountPenalty(t *testing.T) {
+	const raw = `{"code":11133,"msg":"Invalid request parameters","requestId":"req-model-param","extError":{"code":"model_param_invalid","message":"the request parameters were rejected by the model provider"}}`
+	const hint = "request parameters were rejected by the model provider; check message format and model capabilities"
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stream=%t", stream), func(t *testing.T) {
+			calls := 0
+			up := newFakeUpstream(t, func(string) (int, string, bool) {
+				calls++
+				return http.StatusBadRequest, raw, false
+			})
+			p := testPoolWith(
+				&auth.Auth{UID: "param-a1", AccessToken: "at1", ExpiresAt: 9999999999},
+				&auth.Auth{UID: "param-a2", AccessToken: "at2", ExpiresAt: 9999999999},
+			)
+			p.SetMaxInFlight(1)
+			h := NewHandler(Config{Pool: p, Upstream: up})
+			rec := httptest.NewRecorder()
+			body := fmt.Sprintf(`{"model":"cn:deepseek-v4.1-flash","stream":%t,"messages":[{"role":"user","content":"hi"}]}`, stream)
+			h.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(body)))
+
+			if rec.Code != http.StatusBadRequest {
+				t.Fatalf("status=%d want 400, body=%s", rec.Code, rec.Body)
+			}
+			if got := rec.Header().Get("Content-Type"); !strings.HasPrefix(got, "application/json") {
+				t.Errorf("Content-Type=%q want application/json before streaming headers", got)
+			}
+			var e hintEnvelope
+			if err := json.Unmarshal(rec.Body.Bytes(), &e); err != nil {
+				t.Fatalf("response must be JSON: %v body=%s", err, rec.Body)
+			}
+			if e.Error.Code != "model_param_invalid" || e.Error.Type != "api_error" {
+				t.Errorf("error code/type=%q/%q", e.Error.Code, e.Error.Type)
+			}
+			if e.Error.Message != raw {
+				t.Errorf("message=%q want verbatim upstream body %q", e.Error.Message, raw)
+			}
+			if e.Error.GatewayHint == nil || *e.Error.GatewayHint != hint {
+				t.Errorf("gateway_hint=%v want existing model-parameter hint", e.Error.GatewayHint)
+			}
+			if calls != 1 {
+				t.Errorf("upstream calls=%d want 1", calls)
+			}
+			for _, uid := range []string{"param-a1", "param-a2"} {
+				st, _ := p.Status(uid)
+				if st.Cooling || st.Disabled || st.ErrTotal != 0 || st.ConsecutiveFails != 0 || !st.DegradeUntil.IsZero() || st.BreakerFails != 0 || !st.BreakerUntil.IsZero() || st.InFlight != 0 {
+					t.Errorf("%s must remain healthy with its lease released: %+v", uid, st)
+				}
+			}
+		})
+	}
+}
