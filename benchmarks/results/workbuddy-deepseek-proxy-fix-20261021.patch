+		t.Run(tc.name, func(t *testing.T) {
+			c := &Client{}
+			out := c.prepareBody([]byte(`{"model":"deepseek-v4.1-flash","reasoning_effort":"off","max_tokens":1000,"messages":[]}`), tc.realm, "", "")
+			var body map[string]any
+			if err := json.Unmarshal(out, &body); err != nil {
+				t.Fatal(err)
+			}
+			if got := body["reasoning_effort"]; got != tc.want {
+				t.Errorf("reasoning_effort=%v want %s", got, tc.want)
+			}
+			if got := body["max_tokens"]; got != float64(1000) {
+				t.Errorf("max_tokens=%v want 1000", got)
+			}
+			if typ, _ := getThinkingType(t, out); typ != "enabled" {
+				t.Errorf("thinking.type=%q want enabled", typ)
+			}
+		})
+	}
+}
