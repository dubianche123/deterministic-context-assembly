+// A cold client must normalize with its realm's catalog before any model discovery.
+func TestPrepareBodyColdEffortFallback(t *testing.T) {
+	for _, tc := range []struct {
+		name, realm, want string
+	}{
+		{"cn", "cn", "low"},
+		{"empty realm uses cn", "", "low"},
+		{"global", "global", "high"},
